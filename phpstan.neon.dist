parameters:
    level: 10
    phpVersion: 80100
    paths:
        - Api
        - Model
        - Plugin
        - ViewModel
        - Test
        - registration.php
    bootstrapFiles:
        - ../../../vendor/autoload.php
    scanFiles:
        - Test/phpstan/generated/LinkElementFactory.php
        - Test/phpstan/generated/MetaElementFactory.php
        - Test/phpstan/generated/ScriptElementFactory.php
        - Test/phpstan/generated/StyleElementFactory.php
    scanDirectories:
        - ../../../dev/tests/integration/framework
